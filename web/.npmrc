# .npmrc — đặt tại mỗi app (web/, admin/, backend/)
# Mục đích: chuẩn hoá cài đặt npm cho cả local lẫn CI/CD, giảm lỗi EPERM / native binary.

# Không tự động chạy install scripts của optional dependencies
# (giúp tránh một số postinstall gây EPERM trên Windows)
# Lưu ý: nếu tắt, một số package cần postinstall sẽ không hoạt động. Để an toàn, bật lại.
# ignore-scripts=true

# Tăng timeout cho việc fetch network lần đầu
fetch-timeout=600000
fetch-retries=3

# Không tự tạo lockfile khi install (CI/CD sẽ dùng npm ci)
# package-lock=false

# Giảm bớt log verbose khi CI chạy
fund=false
audit=false

# Tắt update-notifier để CI log gọn
update-notifier=false

# Ưu tiên dùng binary platform đã được prebuilt (tránh build from source gây lỗi)
# Đây là default nhưng ép lại cho chắc:
prefer-offline=false
