# =========================================
# Backend - Environment Configuration
# Copy file nay thanh `.env` (development) hoac
# `.env.production` (production) roi dien gia tri.
# =========================================

# ---- App ----
NODE_ENV=development
APP_NAME=xgym-backend
# Port backend. Mac dinh 3000 neu khong set, nhung deploy.sh dung 8011.
APP_PORT=8011
PORT=8011
# Domain frontend (de build absolute URL cho email/redirect).
FRONTEND_DOMAIN=http://localhost:3000
# Domain backend (de build absolute URL cho media, callback...).
BACKEND_DOMAIN=http://localhost:8011
# Tien to API. Hien tai `main.ts` dang comment global prefix, nhung
# config validator van check bien nay nen de mac dinh `api`.
API_PREFIX=api

# ---- Database (MongoDB) ----
# URI mac dinh (local docker): mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=xgym

# ---- Auth (JWT) ----
# Tao secret bang: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_JWT_REFRESH_SECRET=replace-with-another-long-random-secret
AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Mailer (SMTP) ----
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=your-email@gmail.com
MAILER_PASSWORD=your-app-password
MAILER_DEFAULT_EMAIL=no-reply@xgym.vn
MAILER_DEFAULT_NAME=X-Gym & Dance
MAILER_SECURE=false
MAILER_IGNORE_TLS=false
MAILER_REQUIRE_TLS=true

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8011/api/v1/auth/google/callback

# ---- CORS ----
# Danh sach origin duoc phep, phan cach bang dau phay.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5020,http://localhost:5011

# ---- Media (upload local) ----
MEDIA_LOCAL_DIR=uploads
